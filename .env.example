# Copy to .env.local for development. On Render, set these in the service's Environment tab.

# --- Runtime ---
# production → serve the built app from dist/ (set by render.yaml / Dockerfile). Leave unset for `npm run dev`.
NODE_ENV=production
# Public URL of the deployment. QR codes and payment links are built from it.
APP_URL=https://your-service.onrender.com

# --- Zora (optional) ---
# Gemini key for live AI answers. Without it Zora answers from the built-in banking logic.
GEMINI_API_KEY=

# --- Intellect complaint gateway (required for the grievance form) ---
INTELLECT_BASE_URL=https://api.in.intellectseecstag.com
INTELLECT_API_KEY=
INTELLECT_USERNAME=
INTELLECT_PASSWORD=
INTELLECT_WORKSPACE_ID=
INTELLECT_ASSET_ID=

# --- Static-hosting only (GitHub Pages etc.), not needed on Render ---
VITE_BACKEND_URL=
